{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false
  },
  "projects": {
    "fartoviy": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist",
              "browser": ""
            },
            "index": "src/index.html",
            "browser": "src/main.ts",
            "webWorkerTsConfig": "tsconfig.worker.json",
            "tsConfig": "tsconfig.app.json",
            "baseHref": "./",
            "assets": [
              {
                "glob": "ort-wasm-simd-threaded.{mjs,wasm}",
                "input": "node_modules/onnxruntime-web/dist",
                "output": "onnx"
              },
              {
                "glob": "**/*",
                "input": "public"
              }
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "700kB",
                  "maximumError": "1MB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "fartoviy:build:production"
            },
            "development": {
              "buildTarget": "fartoviy:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
